<UserControl x:Class="RifeOS.Host.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="clr-namespace:RifeOS.Host.Widgets"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="Segoe UI, Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,24">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="概览工作台" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Widget 监控与倒计时 -->
            <UniformGrid Columns="2" Margin="0,0,0,20">
                <widgets:SystemMonitorWidget Margin="0,0,10,0"/>
                <widgets:CountdownWidget Margin="10,0,0,0"/>
            </UniformGrid>

            <!-- 微内核运行状态面板 -->
            <Border Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="8" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="⚡" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="独立进程级沙箱环境 (ALC 隔离)" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="所有子应用插件独立加载。当从任务栏右键关闭 App 时，系统会立刻触发物理级内存垃圾回收。" 
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" LineHeight="18" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>