<Window x:Class="RifeOS.Host.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:RifeOS.Host.ViewModels"
        Title="RifeOS" Width="1180" Height="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        x:Name="RootShellWindow">

    <Window.DataContext>
        <viewmodels:ShellViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Win10 磁贴样式基类 -->
        <Style x:Key="Win10TileStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TileTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tileBorder" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tileBorder" Property="Opacity" Value="0.88"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#3B82F6" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Win10 左侧列表项样式 -->
        <Style x:Key="Win10AppListItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SubSurfaceBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 窗口主圆角容器 -->
    <Border CornerRadius="12" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- 1. 顶部隐形拖拽条 -->
            <Border Grid.Row="0" Background="Transparent" MouseDown="TitleBar_MouseDown"/>

            <!-- 2. 主工作区 -->
            <Grid Grid.Row="1">
                <!-- 全新 Desktop Shell 外壳层 (置于最底层) -->
                <local:DesktopView xmlns:local="clr-namespace:RifeOS.Host.Views" />

                <!-- 动态插件应用容器 (悬浮于桌面之上) -->
                <ContentControl Content="{Binding CurrentAppView}"/>

                <!-- 动态插件容器 -->
                <ContentControl Content="{Binding CurrentAppView}"/>

                <!-- 右上角 Toast 通知浮层 -->
                <ItemsControl ItemsSource="{Binding ActiveToasts}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,16,0" Width="300" Panel.ZIndex="20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Content}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ==================== Windows 10 风格开始菜单 ==================== -->
                <Border Width="640" Height="460" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="10,0,0,0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="0" Panel.ZIndex="50"
                        MouseLeave="StartMenu_MouseLeave"
                        ContextMenuOpening="StartMenu_ContextMenuOpening"
                        ContextMenuClosing="StartMenu_ContextMenuClosing"
                        Visibility="{Binding IsStartMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- 0: 最左侧功能窄栏 (已移除无用三条横杠) -->
                            <ColumnDefinition Width="48"/>
                            <!-- 1: 左侧应用列表 -->
                            <ColumnDefinition Width="220"/>
                            <!-- 2: 竖向分割线 -->
                            <ColumnDefinition Width="1"/>
                            <!-- 3: 右侧磁贴区域 -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- [0] 最左侧窄栏：干净纯粹的系统动作入口 -->
                        <Border Grid.Column="0" Background="{DynamicResource SubSurfaceBackgroundBrush}" Padding="0,0,0,10">
                            <StackPanel VerticalAlignment="Bottom">
                                <Button Width="40" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="系统设置"
                                        Command="{Binding LaunchAppCommand}" CommandParameter="Settings">
                                    <TextBlock Text="⚙" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Width="40" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="退出系统"
                                        Command="{Binding ExitSystemCommand}">
                                    <TextBlock Text="⏻" FontSize="15" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- [1] 左侧应用列表 (图标颜色主题自适应) -->
                        <Border Grid.Column="1" Padding="12,14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="所有应用" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,8"/>

                                    <ItemsControl ItemsSource="{Binding AllApps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Win10AppListItemStyle}"
                                                        Tag="{Binding ElementName=RootShellWindow, Path=DataContext}"
                                                        Command="{Binding DataContext.LaunchAppCommand, ElementName=RootShellWindow}"
                                                        CommandParameter="{Binding AppKey}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                                            <MenuItem Header="📌 固定到“开始”屏幕"
                                                                      Command="{Binding PlacementTarget.Tag.PinToTilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>

                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- 图标底色随主题动态切换 -->
                                                        <Border Width="24" Height="24" CornerRadius="4" Margin="0,0,10,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource TileDefaultBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AppKey}" Value="Tasks">
                                                                            <Setter Property="Background" Value="{DynamicResource TileTasksBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding AppKey}" Value="Settings">
                                                                            <Setter Property="Background" Value="{DynamicResource TileSettingsBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding AppKey}" Value="Overview">
                                                                            <Setter Property="Background" Value="{DynamicResource TileOverviewBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Icon}" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- [2] 分割线 -->
                        <Border Grid.Column="2" Background="{DynamicResource BorderBrush}"/>

                        <!-- [3] 右侧 Win10 磁贴区域 (背景色与主题全量联动) -->
                        <Border Grid.Column="3" Padding="16,14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="已固定磁贴" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                    <ItemsControl ItemsSource="{Binding PinnedTiles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,8,8"
                                                        Tag="{Binding ElementName=RootShellWindow, Path=DataContext}"
                                                        Command="{Binding DataContext.LaunchAppCommand, ElementName=RootShellWindow}"
                                                        CommandParameter="{Binding AppKey}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Win10TileStyle}">
                                                            <Setter Property="Width" Value="160"/>
                                                            <Setter Property="Height" Value="90"/>
                                                            <Setter Property="Padding" Value="10"/>
                                                            <Setter Property="Background" Value="{DynamicResource TileDefaultBrush}"/>
                                                            <Style.Triggers>
                                                                <!-- 宽磁贴尺寸判定 -->
                                                                <DataTrigger Binding="{Binding IsWide}" Value="True">
                                                                    <Setter Property="Width" Value="328"/>
                                                                    <Setter Property="Height" Value="90"/>
                                                                    <Setter Property="Padding" Value="14,10"/>
                                                                </DataTrigger>
                                                                <!-- 磁贴主题色彩联动判定 -->
                                                                <DataTrigger Binding="{Binding AppKey}" Value="Tasks">
                                                                    <Setter Property="Background" Value="{DynamicResource TileTasksBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding AppKey}" Value="Settings">
                                                                    <Setter Property="Background" Value="{DynamicResource TileSettingsBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding AppKey}" Value="Overview">
                                                                    <Setter Property="Background" Value="{DynamicResource TileOverviewBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>

                                                    <Button.ContextMenu>
                                                        <ContextMenu Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                                            <MenuItem Header="❌ 从“开始”屏幕取消固定"
                                                                      Command="{Binding PlacementTarget.Tag.UnpinFromTilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>

                                                    <Grid>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,0,0">
                                                            <TextBlock Text="{Binding Icon}" FontSize="24" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                                   Foreground="{DynamicResource TileTextBrush}"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. 底部任务栏 -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 开始按钮 (悬停自动展开) -->
                        <Button Width="36" Height="34" Background="{DynamicResource SubSurfaceBackgroundBrush}" BorderThickness="0" Cursor="Hand"
                                Margin="0,0,10,0" MouseEnter="StartButton_MouseEnter">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="R" FontSize="15" FontWeight="Bold" Foreground="#3B82F6" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 动态任务栏标签 -->
                        <ItemsControl ItemsSource="{Binding RunningApps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="32" Margin="0,0,6,0" CornerRadius="6" Padding="10,0" 
                                            Background="{DynamicResource SubSurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            Tag="{Binding ElementName=RootShellWindow, Path=DataContext}">
                                        <Border.ContextMenu>
                                            <ContextMenu Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                                <MenuItem Header="最小化" 
                                                          Command="{Binding PlacementTarget.Tag.MinimizeAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator Background="{DynamicResource BorderBrush}"/>
                                                <MenuItem Header="关闭应用" Foreground="#EF4444"
                                                          Command="{Binding PlacementTarget.Tag.CloseAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding DataContext.SwitchToAppCommand, ElementName=RootShellWindow}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Icon}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Column="1" Content="✕" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Width="18" Height="18"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.CloseAppCommand, ElementName=RootShellWindow}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 右侧极简状态栏 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="RifeOS Shell" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>