<Application x:Class="RifeOS.Host.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="Views/ShellWindow.xaml">
    <Application.Resources>
        <!-- 基础调色板 (默认深色) -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F0F11"/>
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#161619"/>
        <SolidColorBrush x:Key="SubSurfaceBackgroundBrush" Color="#1E1E22"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#28282D"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#888888"/>
        <sys:Double x:Key="WatermarkOpacity">0.12</sys:Double>

        <!-- 磁贴与 App 专属主题联动画刷 (深色默认) -->
        <SolidColorBrush x:Key="TileTasksBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="TileSettingsBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="TileDashboardBrush" Color="#047857"/>
        <SolidColorBrush x:Key="TileDefaultBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="TileTextBrush" Color="#FFFFFF"/>
    </Application.Resources>
</Application>