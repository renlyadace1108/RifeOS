<Application x:Class="RifeOS.Host.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
    </Application.Resources>
</Application>
