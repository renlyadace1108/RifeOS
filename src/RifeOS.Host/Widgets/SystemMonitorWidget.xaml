<UserControl x:Class="RifeOS.Host.Widgets.SystemMonitorWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="130" Background="#1A1A1A">
    <Border CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <TextBlock Text="⚡" FontSize="13" Foreground="#10B981" Margin="0,0,6,0"/>
                <TextBlock Text="系统资源状态" FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="宿主物理工作集" FontSize="11" Foreground="#888888"/>
                    <TextBlock x:Name="TxtHostRam" Text="-- MB" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="系统运行时长" FontSize="11" Foreground="#888888"/>
                    <TextBlock x:Name="TxtUptime" Text="--:--" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>